<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="sharedpref" path="vela_sync.xml" />
        <exclude domain="file" path="Vela/sync-state.json" />
        <exclude domain="file" path="Vela/sync-state.json.corrupt" />
        <exclude domain="file" path="Vela/sync-join-snapshot" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="sharedpref" path="vela_sync.xml" />
        <exclude domain="file" path="Vela/sync-state.json" />
        <exclude domain="file" path="Vela/sync-state.json.corrupt" />
        <exclude domain="file" path="Vela/sync-join-snapshot" />
    </device-transfer>
</data-extraction-rules>
