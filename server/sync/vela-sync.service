# systemd unit template. Paths and the user are deployment placeholders;
# do not put a real hostname, address, or secret in this file.
# Create the user, group, and data directory before enabling:
#   useradd --system --home-dir /var/lib/vela-sync --shell /usr/sbin/nologin vela-sync
#   install -d -o vela-sync -g vela-sync -m 0700 /var/lib/vela-sync
# journald retention (14 days) is host-wide; see journald-vela-sync.conf.

[Unit]
Description=Vela sync blob service
After=network.target

[Service]
Type=simple
User=vela-sync
Group=vela-sync
WorkingDirectory=/var/lib/vela-sync
ExecStart=/usr/bin/python3 /opt/vela/server/sync/app.py --db /var/lib/vela-sync/sync.db --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=1
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/vela-sync
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallFilter=@system-service
# 只和同机的 cloudflared 通信（第 10.3 节）。
IPAddressDeny=any
IPAddressAllow=localhost
# 并发连接上限 32 是设计稿写死的（第 10.3 节），每个请求体最多约 800 KB、解析时还要翻倍，
# 所以提高内存上限而不是降低并发：32 x 约 2 MB 加解释器与 SQLite 缓存，128M 余量不足。
MemoryMax=256M
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
